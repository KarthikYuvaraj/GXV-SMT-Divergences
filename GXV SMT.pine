//@version=6
indicator("✦ GXV SMT Divergences-Lite", overlay=true, max_labels_count=500, max_lines_count=500)
import Gregorius_XV/GXVAssetCorrelationUtils/1 as GXV

//==============================================================================
// Release identity / canonical author fingerprint
//==============================================================================
const string GXV_SMT_AUTHOR = "Gregorius_XV"
const string GXV_SMT_CANONICAL_PUBLISHER = "TradingView: Gregorius_XV"
const string GXV_SMT_RELEASE_NAME = "✦ GXV SMT Divergences-Lite"
const string GXV_SMT_RELEASE_VERSION = "v2.3.0-source-cycles"
const string GXV_SMT_RELEASE_DATE = "2026-09-14"
const string GXV_SMT_LICENSE = "MPL-2.0"
const string GXV_SMT_AUTHOR_FINGERPRINT = "GXV-SMT-LITE::ORIGINAL::GREGORIUS_XV::2026-07-08::v1.0.0"

// v2.3 acquisition contract: native time()/time_close() windows; chart-OHLC
// accumulation in each symbol's own execution context BEFORE request merging.
// Three companion contexts maximum, independent of the thirteen ranks. Main
// extreme coordinates remain local. Closed prices come from source rollover;
// developing prices use ordinary rollback and are never permanent close proof.
// Exact aggregation requires contained source bars and available start history.
// Native EOD feed parity and provider revisions are outside this guarantee.

//==============================================================================
// Inputs — GXV normal SMT module subset
//==============================================================================
g_smt = "SMT Visual Settings"
g_smt_gates = "SMT Gates Settings"
g_smt_ranks = "SMT Render Settings"
g_smt_sessions = "SMT Session Filter Settings"
g_smt_assets = "SMT Asset Pair Resolver Settings"

const string TIP_DYNAMIC_SMT_LABELS = "When enabled, hides SMT labels on the exact chart timeframe used as that SMT family's maximum calculation gate. 3M and 12M labels are excluded."
const string TIP_DISPLAY_CAP = "Maximum retained SMTs per timeframe, pair, and direction bucket."
const string TIP_NEARBY_ONLY = "Shows only SMTs whose endpoint is within the latest chart bars."
const string TIP_CLEANUP = "Controls conflict handling. All removes lower-priority conflicts; Bypass modes keep conflicts but fade the bypassed SMT; None disables cleanup."
const string TIP_AESTHETIC_BYPASS = "In Bypass cleanup modes, keeps conflicting SMTs visible with lower contrast instead of fully removing them."
const string TIP_BYPASS_LABELS = "Shows labels on faded bypassed SMTs. Turn off for cleaner charts."
const string TIP_SESSION_FILTER = "Filters SNTs using Sessions time windows"
const string TIP_AUTO_SESSION = "Automatically selects one session from the latest chart candle time. Timing fields are locked while Auto is on, but their stored values are still used."
const string TIP_MANUAL_PAIRS = "Manual Pairs inputs are for correlated assets. Current Asset is fetched from current chart asset."


smt_txt_all = input.color(#4a4a4a, "SMT Text", inline="smt_txt", group=g_smt)
smt_label_style = input.string("TF + Asset", "SMT Label Style", options=["TF + Asset", "Asset Only", "TF Only"], group=g_smt)
smt_label_size = input.string(size.tiny, "SMT Labels Size", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=g_smt)
smt_labels_show = input.bool(true, "SMT Labels?", group=g_smt)
smt_dynamic_labels = input.bool(true, "Dynamic SMT Labels?", group=g_smt, tooltip=TIP_DYNAMIC_SMT_LABELS)

smt_render_nearby_only = input.bool(false, "Render Gate?  ", group=g_smt_gates, tooltip=TIP_NEARBY_ONLY, inline='renderbars')
smt_nearby_bars = input.int(400, " ", minval=1, maxval=5000, group=g_smt_gates, active=smt_render_nearby_only, inline='renderbars')
smt_history_limit = input.int(20, "Display Cap", minval=1, maxval=100, group=g_smt_gates)
smt_monthly_min_tf = input.string("1 Hour", "Monthly SMTs TF ≥.", options=["None", "1 Hour", "4 Hour", "1 Day"], group=g_smt_gates)

smt_15m_show = input.bool(false, "15m", inline="smt_r1", group=g_smt_ranks)
smt_15m_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks)
smt_30m_show = input.bool(false, "30m", inline="smt_r1", group=g_smt_ranks)
smt_30m_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks)
smt_1h_show = input.bool(true, "1H ", inline="smt_r1", group=g_smt_ranks)
smt_1h_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks)
smt_90m_show = input.bool(true, "90m", inline="smt_r1", group=g_smt_ranks)
smt_90m_clr = input.color(#dbdbdb, "", inline="smt_r1", group=g_smt_ranks)
smt_4h_show = input.bool(true, "4H ", inline="smt_r2", group=g_smt_ranks)
smt_4h_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks)
smt_6h_show = input.bool(false, "6H ", inline="smt_r2", group=g_smt_ranks)
smt_6h_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks)
smt_7h_show = input.bool(true, "7H ", inline="smt_r2", group=g_smt_ranks)
smt_7h_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks)
smt_12h_show = input.bool(true, "12H", inline="smt_r2", group=g_smt_ranks)
smt_12h_clr = input.color(#dbdbdb, "", inline="smt_r2", group=g_smt_ranks)
smt_1d_show = input.bool(true, "1D ", inline="smt_r3", group=g_smt_ranks)
smt_1d_clr = input.color(#b8b8b8, "", inline="smt_r3", group=g_smt_ranks)
smt_1w_show = input.bool(true, "1W ", inline="smt_r3", group=g_smt_ranks)
smt_1w_clr = input.color(#b8b8b8, "", inline="smt_r3", group=g_smt_ranks)
smt_1m_show = input.bool(false, "1M ", inline="smt_r3", group=g_smt_ranks)
smt_1m_clr = input.color(#9c9c9c, "", inline="smt_r3", group=g_smt_ranks)
smt_3m_show = input.bool(false, "3M ", inline="smt_r3", group=g_smt_ranks)
smt_3m_clr = input.color(#636363, "", inline="smt_r3", group=g_smt_ranks)
smt_12m_show = input.bool(false, "12M", inline="smt_r4", group=g_smt_ranks)
smt_12m_clr = input.color(#2e2e2e, "", inline="smt_r4", group=g_smt_ranks)

smt_line_style_input = input.string("___", "SMT Line Style", options=["___", "----", "...."], group=g_smt_ranks)
smt_line_style = smt_line_style_input == "----" ? line.style_dashed : smt_line_style_input == "...." ? line.style_dotted : line.style_solid
smt_cleanup_mode = input.string("All", "SMT Cleanup", options=["All", "Bypass Pivot A", "Bypass Pivot B", "Bypass Inside Range", "None"], group=g_smt_ranks, tooltip=TIP_CLEANUP)
smt_aesthetic_bypass = input.bool(true, "Aesthetic Bypass?", inline="smt_bypass", group=g_smt_ranks, active=smt_cleanup_mode == "Bypass Pivot A" or smt_cleanup_mode == "Bypass Pivot B" or smt_cleanup_mode == "Bypass Inside Range", tooltip=TIP_AESTHETIC_BYPASS)
smt_bypass_labels_show = input.bool(false, "Bypass Labels?", inline="smt_bypass", group=g_smt_ranks, active=smt_aesthetic_bypass and (smt_cleanup_mode == "Bypass Pivot A" or smt_cleanup_mode == "Bypass Pivot B" or smt_cleanup_mode == "Bypass Inside Range"), tooltip=TIP_BYPASS_LABELS)
smt_cleanup_pivot_a = smt_cleanup_mode != "Bypass Pivot A" and smt_cleanup_mode != "None"
smt_cleanup_pivot_b = smt_cleanup_mode != "Bypass Pivot B" and smt_cleanup_mode != "None"
smt_cleanup_inside = smt_cleanup_mode != "Bypass Inside Range" and smt_cleanup_mode != "None"

smt_session_filter_on = input.bool(false, "Enable SMT Session Filter?", inline="smt_sess_master", group=g_smt_sessions, tooltip=TIP_SESSION_FILTER)
smt_auto_session_filter = input.bool(false, "Auto", inline="smt_sess_master", group=g_smt_sessions, active=smt_session_filter_on, tooltip=TIP_AUTO_SESSION)
smt_session_1_on = input.bool(false, "Asia   ", inline="smt_sess1", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter)
smt_session_1_start = input.string("20:00", "", options=["20:00", "20:30", "21:00", "21:30"], inline="smt_sess1", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_1_on)
smt_session_1_end = input.string("00:00", "—", options=["00:00", "00:30", "01:00", "01:30"], inline="smt_sess1", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_1_on)
smt_session_2_on = input.bool(false, "London", inline="smt_sess2", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter)
smt_session_2_start = input.string("02:00", "", options=["01:30", "02:00", "02:30", "03:00"], inline="smt_sess2", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_2_on)
smt_session_2_end = input.string("06:00", "—", options=["05:00", "05:30", "06:00", "06:30"], inline="smt_sess2", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_2_on)
smt_session_3_on = input.bool(true, "NY-AM ", inline="smt_sess3", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter)
smt_session_3_start = input.string("07:30", "", options=["07:30", "08:00", "08:30", "09:00"], inline="smt_sess3", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_3_on)
smt_session_3_end = input.string("12:00", "—", options=["12:00", "12:30", "13:00", "13:30"], inline="smt_sess3", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_3_on)
smt_session_4_on = input.bool(false, "NY-PM ", inline="smt_sess4", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter)
smt_session_4_start = input.string("13:30", "", options=["13:00", "13:30", "14:00", "14:30"], inline="smt_sess4", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_4_on)
smt_session_4_end = input.string("17:00", "—", options=["17:00", "17:30", "18:00", "18:30"], inline="smt_sess4", group=g_smt_sessions, active=smt_session_filter_on and not smt_auto_session_filter and smt_session_4_on)
smt_render_current_day_only = input.bool(false, "Render Only Current Day Range                                            ", group=g_smt_sessions)

smt_pair_selection = input.string("Auto", "Pair Selection", options=["Auto", "Manual"], group=g_smt_assets, tooltip=TIP_MANUAL_PAIRS)
smt_correlation_mode = input.string("Classic", "Correlation Mode", options=["GXT", "Classic"], group=g_smt_assets)
smt_correlation_type = input.string("Triad", "Correlation Type", options=["Dyad", "Triad", "Tetrad"], group=g_smt_assets)
smt_manual_pair1 = input.symbol("", "Pair 1", inline="smt_manual_pair1", group=g_smt_assets, active=smt_pair_selection == "Manual")
smt_manual_pair1_inverted = input.bool(false, "Inversed?", inline="smt_manual_pair1", group=g_smt_assets, active=smt_pair_selection == "Manual")
smt_manual_pair2 = input.symbol("", "Pair 2", inline="smt_manual_pair2", group=g_smt_assets, active=smt_pair_selection == "Manual" and smt_correlation_type != "Dyad")
smt_manual_pair2_inverted = input.bool(false, "Inversed?", inline="smt_manual_pair2", group=g_smt_assets, active=smt_pair_selection == "Manual" and smt_correlation_type != "Dyad")
smt_manual_pair3 = input.symbol("", "Pair 3", inline="smt_manual_pair3", group=g_smt_assets, active=smt_pair_selection == "Manual" and smt_correlation_type == "Tetrad")
smt_manual_pair3_inverted = input.bool(false, "Inversed?", inline="smt_manual_pair3", group=g_smt_assets, active=smt_pair_selection == "Manual" and smt_correlation_type == "Tetrad")

//==============================================================================
// Time declarations and GXV auto timezone/session helpers
//==============================================================================
tf = timeframe.period
tf_sec = timeframe.in_seconds(tf)

// Only these series need dynamic lookbacks. Do not reserve 5000 bars for
// every request payload, temporary object, and unrelated intermediate series.
max_bars_back(open, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)
max_bars_back(time_close, 1)
f_is_mid_prefix(string px) =>
    px == "CAPITALCOM" or px == "CMCMARKETS"

f_is_chicago_prefix(string px) =>
    px == "CME" or px == "CBOT" or px == "CBOT_MINI" or px == "CBOT_DL" or px == "CME_MINI" or px == "CME_DL" or px == "CME_MINI_DL" or px == "COMEX" or px == "NYMEX"

f_is_utc_prefix(string px) =>
    px == "BINANCE" or px == "BYBIT" or px == "KRAKEN" or px == "GATE.IO" or px == "BITSTAMP" or px == "COINBASE" or px == "GEMINI"

f_oracle_tz(string px) =>
    f_is_chicago_prefix(px) ? "America/Chicago" : f_is_mid_prefix(px) ? "Etc/GMT+5" : f_is_utc_prefix(px) ? "UTC" : "America/New_York"

// Oracle timezone is DISPLAY/session-filter policy only, never an acquisition clock.
px = syminfo.prefix
oracle_tz = f_oracle_tz(px)

// Native candle clocks and accumulation are defined after the stable TF gates.
// GXV chart-timeframe gates — hardcoded stable reconstruction-safe gates.
const int TF_SEC_1 = 60
const int TF_SEC_5 = 5 * TF_SEC_1
const int TF_SEC_15 = 15 * TF_SEC_1
const int TF_SEC_30 = 30 * TF_SEC_1
const int TF_SEC_60 = 60 * TF_SEC_1
const int TF_SEC_240 = 240 * TF_SEC_1
const int TF_SEC_360 = 360 * TF_SEC_1
const int TF_SEC_D = 24 * 60 * 60
const int TF_SEC_M = 30 * TF_SEC_D

SMT_GATE_15M = TF_SEC_5
SMT_GATE_30M = TF_SEC_5
SMT_GATE_90M = TF_SEC_15
SMT_GATE_1H = TF_SEC_15
SMT_GATE_4H = TF_SEC_60
SMT_GATE_6H = TF_SEC_60
SMT_GATE_7H = TF_SEC_60
SMT_GATE_12H = TF_SEC_240
SMT_GATE_1D = TF_SEC_240
SMT_GATE_1W = TF_SEC_360
SMT_GATE_1M = TF_SEC_360
SMT_GATE_3M = TF_SEC_D
SMT_GATE_12M = TF_SEC_M
tf_ok_15m = tf_sec <= SMT_GATE_15M
tf_ok_30m = tf_sec <= SMT_GATE_30M
tf_ok_90m = tf_sec <= SMT_GATE_90M
tf_ok_1h = tf_sec <= SMT_GATE_1H
tf_ok_4h = tf_sec <= SMT_GATE_4H
tf_ok_6h = tf_sec <= SMT_GATE_6H
tf_ok_7h = tf_sec <= SMT_GATE_7H
tf_ok_12h = tf_sec <= SMT_GATE_12H
tf_ok_1d = tf_sec <= SMT_GATE_1D
tf_ok_1w = tf_sec <= SMT_GATE_1W
tf_ok_1m = tf_sec <= SMT_GATE_1M
tf_ok_3m = tf_sec <= SMT_GATE_3M
tf_ok_12m = tf_sec <= SMT_GATE_12M

// Monthly SMT minimum chart-timeframe render policy.
// Display authority only: existing SMT compute gates and lifecycle state remain unchanged.
f_smt_monthly_tf_render_ok(int rank) =>
    bool isMonthlyRank = rank == 11 or rank == 12 or rank == 13
    int minTfSec = smt_monthly_min_tf == "1 Hour" ? TF_SEC_60 : smt_monthly_min_tf == "4 Hour" ? TF_SEC_240 : smt_monthly_min_tf == "1 Day" ? TF_SEC_D : 0
    not isMonthlyRank or minTfSec == 0 or tf_sec >= minTfSec


// Native clock / source-owned accumulation. Every written source-cycle call owns
// its own bounded state and runs on EVERY available bar of that symbol.
// No Oracle hour overrides: compare actual symbol/session A/B intervals.
// Main coordinates stay local; companion requests transport prices/intervals only.
type SmtCandle
    int openTime = na
    int closeTime = na
    float hi = na
    float lo = na
    int hiTime = na
    int loTime = na
    int hiBar = na
    int loBar = na
    bool complete = false

type SmtCycle
    SmtCandle current
    SmtCandle previous
    SmtCandle older
    int crossingEnd = na

type SmtCycleSet
    SmtCycle r1
    SmtCycle r2
    SmtCycle r3
    SmtCycle r4
    SmtCycle r5
    SmtCycle r6
    SmtCycle r7
    SmtCycle r8
    SmtCycle r9
    SmtCycle r10
    SmtCycle r11
    SmtCycle r12
    SmtCycle r13

// Three windows supply current A/B and the most recent CLOSED A/B comparison.
// Scalar fields only; no raw-bar arrays or unbounded history crosses a request.
type SmtRemoteCycle
    int cOpen
    int cClose
    float cHigh
    float cLow
    bool cComplete
    int pOpen
    int pClose
    float pHigh
    float pLow
    bool pComplete
    int aOpen
    int aClose
    float aHigh
    float aLow
    bool aComplete

