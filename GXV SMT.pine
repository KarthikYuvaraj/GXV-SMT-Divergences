    float r13_pLow
    bool r13_pComplete
    int r13_aOpen
    int r13_aClose
    float r13_aHigh
    float r13_aLow
    bool r13_aComplete

type SmtSourcePacket
    int sampleTime
    int sampleClose
    SmtSourceBlock1 firstRanks
    SmtSourceBlock2 lastRanks

f_smt_accumulate(SmtCycle st, int windowOpen, int windowClose, float srcHigh, float srcLow, int srcTime, int srcClose, int srcBar, int priorClose) =>
    bool clockReady = not na(windowOpen) and not na(windowClose) and windowClose > windowOpen and not na(srcTime) and not na(srcClose)
    if clockReady
        SmtCandle c = st.current
        if na(c.openTime) or windowOpen > c.openTime
            st.older := st.previous
            st.previous := c
            bool firstInWindow = srcTime == windowOpen or (not na(priorClose) and priorClose <= windowOpen)
            bool noCrossing = na(st.crossingEnd) or st.crossingEnd <= windowOpen
            c := SmtCandle.new(openTime=windowOpen, closeTime=windowClose, complete=firstInWindow and noCrossing)
            st.current := c
        if windowOpen == c.openTime
            bool contained = srcTime >= windowOpen and srcClose <= windowClose and srcClose > srcTime
            bool pricesReady = not na(srcHigh) and not na(srcLow)
            c.complete := c.complete and contained and pricesReady and c.closeTime == windowClose
            if not contained
                st.crossingEnd := na(st.crossingEnd) ? srcClose : math.max(st.crossingEnd, srcClose)
            else if pricesReady
                if na(c.hi) or srcHigh > c.hi
                    c.hi := srcHigh
                    c.hiTime := srcTime
                    c.hiBar := srcBar
                if na(c.lo) or srcLow < c.lo
                    c.lo := srcLow
                    c.loTime := srcTime
                    c.loBar := srcBar
    0

f_smt_source_cycle(int windowOpen, int windowClose, bool enabled) =>
    var SmtCycle st = SmtCycle.new(SmtCandle.new(), SmtCandle.new(), SmtCandle.new())
    // No consumer reads st[1]. Rollover allocates a fresh current candle and
    // never mutates closed candles. Ordinary var rollback restores live fields;
    // copying the wrapper/current on every bar only retains redundant objects.
    if enabled
        f_smt_accumulate(st, windowOpen, windowClose, high, low, time, time_close, bar_index, time_close[1])
    st

f_smt_source_cycles() =>
    SmtCycle r1 = f_smt_source_cycle(time("15"), time_close("15"), tf_ok_15m)
    SmtCycle r2 = f_smt_source_cycle(time("30"), time_close("30"), tf_ok_30m)
    SmtCycle r3 = f_smt_source_cycle(time("60"), time_close("60"), tf_ok_1h)
    SmtCycle r4 = f_smt_source_cycle(time("90"), time_close("90"), tf_ok_90m)
    SmtCycle r5 = f_smt_source_cycle(time("240"), time_close("240"), tf_ok_4h)
    SmtCycle r6 = f_smt_source_cycle(time("360"), time_close("360"), tf_ok_6h)
    SmtCycle r7 = f_smt_source_cycle(time("420"), time_close("420"), tf_ok_7h)
    SmtCycle r8 = f_smt_source_cycle(time("720"), time_close("720"), tf_ok_12h)
    SmtCycle r9 = f_smt_source_cycle(time("1D"), time_close("1D"), tf_ok_1d)
    SmtCycle r10 = f_smt_source_cycle(time("1W"), time_close("1W"), tf_ok_1w)
    SmtCycle r11 = f_smt_source_cycle(time("1M"), time_close("1M"), tf_ok_1m)
    SmtCycle r12 = f_smt_source_cycle(time("3M"), time_close("3M"), tf_ok_3m)
    SmtCycle r13 = f_smt_source_cycle(time("12M"), time_close("12M"), tf_ok_12m)
    var SmtCycleSet source = SmtCycleSet.new(r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13)
    source

f_smt_compact_cycle(SmtCycle st) =>
    SmtCandle c = st.current
    SmtCandle p = st.previous
    SmtCandle a = st.older
    SmtRemoteCycle.new(c.openTime, c.closeTime, c.hi, c.lo, c.complete, p.openTime, p.closeTime, p.hi, p.lo, p.complete, a.openTime, a.closeTime, a.hi, a.lo, a.complete)

f_smt_source_packet() =>
    SmtCycleSet source = f_smt_source_cycles()
    SmtCycle r1 = source.r1
    SmtCycle r2 = source.r2
    SmtCycle r3 = source.r3
    SmtCycle r4 = source.r4
    SmtCycle r5 = source.r5
    SmtCycle r6 = source.r6
    SmtCycle r7 = source.r7
    SmtCycle r8 = source.r8
    SmtCycle r9 = source.r9
    SmtCycle r10 = source.r10
    SmtCycle r11 = source.r11
    SmtCycle r12 = source.r12
    SmtCycle r13 = source.r13
    // Two scalar-only blocks keep constructors below 254 external elements.
    // Three transported IDs replace the original fourteen, with all 197 values
    // unchanged. Keep full precision, native intervals, and all three windows.
    SmtSourceBlock1 firstRanks = SmtSourceBlock1.new(r1.current.openTime, r1.current.closeTime, r1.current.hi, r1.current.lo, r1.current.complete, r1.previous.openTime, r1.previous.closeTime, r1.previous.hi, r1.previous.lo, r1.previous.complete, r1.older.openTime, r1.older.closeTime, r1.older.hi, r1.older.lo, r1.older.complete, r2.current.openTime, r2.current.closeTime, r2.current.hi, r2.current.lo, r2.current.complete, r2.previous.openTime, r2.previous.closeTime, r2.previous.hi, r2.previous.lo, r2.previous.complete, r2.older.openTime, r2.older.closeTime, r2.older.hi, r2.older.lo, r2.older.complete, r3.current.openTime, r3.current.closeTime, r3.current.hi, r3.current.lo, r3.current.complete, r3.previous.openTime, r3.previous.closeTime, r3.previous.hi, r3.previous.lo, r3.previous.complete, r3.older.openTime, r3.older.closeTime, r3.older.hi, r3.older.lo, r3.older.complete, r4.current.openTime, r4.current.closeTime, r4.current.hi, r4.current.lo, r4.current.complete, r4.previous.openTime, r4.previous.closeTime, r4.previous.hi, r4.previous.lo, r4.previous.complete, r4.older.openTime, r4.older.closeTime, r4.older.hi, r4.older.lo, r4.older.complete, r5.current.openTime, r5.current.closeTime, r5.current.hi, r5.current.lo, r5.current.complete, r5.previous.openTime, r5.previous.closeTime, r5.previous.hi, r5.previous.lo, r5.previous.complete, r5.older.openTime, r5.older.closeTime, r5.older.hi, r5.older.lo, r5.older.complete, r6.current.openTime, r6.current.closeTime, r6.current.hi, r6.current.lo, r6.current.complete, r6.previous.openTime, r6.previous.closeTime, r6.previous.hi, r6.previous.lo, r6.previous.complete, r6.older.openTime, r6.older.closeTime, r6.older.hi, r6.older.lo, r6.older.complete, r7.current.openTime, r7.current.closeTime, r7.current.hi, r7.current.lo, r7.current.complete, r7.previous.openTime, r7.previous.closeTime, r7.previous.hi, r7.previous.lo, r7.previous.complete, r7.older.openTime, r7.older.closeTime, r7.older.hi, r7.older.lo, r7.older.complete)
    SmtSourceBlock2 lastRanks = SmtSourceBlock2.new(r8.current.openTime, r8.current.closeTime, r8.current.hi, r8.current.lo, r8.current.complete, r8.previous.openTime, r8.previous.closeTime, r8.previous.hi, r8.previous.lo, r8.previous.complete, r8.older.openTime, r8.older.closeTime, r8.older.hi, r8.older.lo, r8.older.complete, r9.current.openTime, r9.current.closeTime, r9.current.hi, r9.current.lo, r9.current.complete, r9.previous.openTime, r9.previous.closeTime, r9.previous.hi, r9.previous.lo, r9.previous.complete, r9.older.openTime, r9.older.closeTime, r9.older.hi, r9.older.lo, r9.older.complete, r10.current.openTime, r10.current.closeTime, r10.current.hi, r10.current.lo, r10.current.complete, r10.previous.openTime, r10.previous.closeTime, r10.previous.hi, r10.previous.lo, r10.previous.complete, r10.older.openTime, r10.older.closeTime, r10.older.hi, r10.older.lo, r10.older.complete, r11.current.openTime, r11.current.closeTime, r11.current.hi, r11.current.lo, r11.current.complete, r11.previous.openTime, r11.previous.closeTime, r11.previous.hi, r11.previous.lo, r11.previous.complete, r11.older.openTime, r11.older.closeTime, r11.older.hi, r11.older.lo, r11.older.complete, r12.current.openTime, r12.current.closeTime, r12.current.hi, r12.current.lo, r12.current.complete, r12.previous.openTime, r12.previous.closeTime, r12.previous.hi, r12.previous.lo, r12.previous.complete, r12.older.openTime, r12.older.closeTime, r12.older.hi, r12.older.lo, r12.older.complete, r13.current.openTime, r13.current.closeTime, r13.current.hi, r13.current.lo, r13.current.complete, r13.previous.openTime, r13.previous.closeTime, r13.previous.hi, r13.previous.lo, r13.previous.complete, r13.older.openTime, r13.older.closeTime, r13.older.hi, r13.older.lo, r13.older.complete)
    SmtSourcePacket.new(time, time_close, firstRanks, lastRanks)

f_smt_local_cycle(SmtCycleSet source, int rank) =>
    rank == 1 ? source.r1 : rank == 2 ? source.r2 : rank == 3 ? source.r3 : rank == 4 ? source.r4 : rank == 5 ? source.r5 : rank == 6 ? source.r6 : rank == 7 ? source.r7 : rank == 8 ? source.r8 : rank == 9 ? source.r9 : rank == 10 ? source.r10 : rank == 11 ? source.r11 : rank == 12 ? source.r12 : source.r13

f_smt_remote_cycle(SmtSourcePacket source, int rank) =>
    // Each written rank/pair path owns one reusable adapter; no past ID is read.
    var SmtRemoteCycle cached = SmtRemoteCycle.new(na, na, na, na, false, na, na, na, na, false, na, na, na, na, false)
    if not na(source)
        cached.cOpen := rank == 1 ? source.firstRanks.r1_cOpen : rank == 2 ? source.firstRanks.r2_cOpen : rank == 3 ? source.firstRanks.r3_cOpen : rank == 4 ? source.firstRanks.r4_cOpen : rank == 5 ? source.firstRanks.r5_cOpen : rank == 6 ? source.firstRanks.r6_cOpen : rank == 7 ? source.firstRanks.r7_cOpen : rank == 8 ? source.lastRanks.r8_cOpen : rank == 9 ? source.lastRanks.r9_cOpen : rank == 10 ? source.lastRanks.r10_cOpen : rank == 11 ? source.lastRanks.r11_cOpen : rank == 12 ? source.lastRanks.r12_cOpen : source.lastRanks.r13_cOpen
        cached.cClose := rank == 1 ? source.firstRanks.r1_cClose : rank == 2 ? source.firstRanks.r2_cClose : rank == 3 ? source.firstRanks.r3_cClose : rank == 4 ? source.firstRanks.r4_cClose : rank == 5 ? source.firstRanks.r5_cClose : rank == 6 ? source.firstRanks.r6_cClose : rank == 7 ? source.firstRanks.r7_cClose : rank == 8 ? source.lastRanks.r8_cClose : rank == 9 ? source.lastRanks.r9_cClose : rank == 10 ? source.lastRanks.r10_cClose : rank == 11 ? source.lastRanks.r11_cClose : rank == 12 ? source.lastRanks.r12_cClose : source.lastRanks.r13_cClose
        cached.cHigh := rank == 1 ? source.firstRanks.r1_cHigh : rank == 2 ? source.firstRanks.r2_cHigh : rank == 3 ? source.firstRanks.r3_cHigh : rank == 4 ? source.firstRanks.r4_cHigh : rank == 5 ? source.firstRanks.r5_cHigh : rank == 6 ? source.firstRanks.r6_cHigh : rank == 7 ? source.firstRanks.r7_cHigh : rank == 8 ? source.lastRanks.r8_cHigh : rank == 9 ? source.lastRanks.r9_cHigh : rank == 10 ? source.lastRanks.r10_cHigh : rank == 11 ? source.lastRanks.r11_cHigh : rank == 12 ? source.lastRanks.r12_cHigh : source.lastRanks.r13_cHigh
        cached.cLow := rank == 1 ? source.firstRanks.r1_cLow : rank == 2 ? source.firstRanks.r2_cLow : rank == 3 ? source.firstRanks.r3_cLow : rank == 4 ? source.firstRanks.r4_cLow : rank == 5 ? source.firstRanks.r5_cLow : rank == 6 ? source.firstRanks.r6_cLow : rank == 7 ? source.firstRanks.r7_cLow : rank == 8 ? source.lastRanks.r8_cLow : rank == 9 ? source.lastRanks.r9_cLow : rank == 10 ? source.lastRanks.r10_cLow : rank == 11 ? source.lastRanks.r11_cLow : rank == 12 ? source.lastRanks.r12_cLow : source.lastRanks.r13_cLow
        cached.cComplete := rank == 1 ? source.firstRanks.r1_cComplete : rank == 2 ? source.firstRanks.r2_cComplete : rank == 3 ? source.firstRanks.r3_cComplete : rank == 4 ? source.firstRanks.r4_cComplete : rank == 5 ? source.firstRanks.r5_cComplete : rank == 6 ? source.firstRanks.r6_cComplete : rank == 7 ? source.firstRanks.r7_cComplete : rank == 8 ? source.lastRanks.r8_cComplete : rank == 9 ? source.lastRanks.r9_cComplete : rank == 10 ? source.lastRanks.r10_cComplete : rank == 11 ? source.lastRanks.r11_cComplete : rank == 12 ? source.lastRanks.r12_cComplete : source.lastRanks.r13_cComplete
        cached.pOpen := rank == 1 ? source.firstRanks.r1_pOpen : rank == 2 ? source.firstRanks.r2_pOpen : rank == 3 ? source.firstRanks.r3_pOpen : rank == 4 ? source.firstRanks.r4_pOpen : rank == 5 ? source.firstRanks.r5_pOpen : rank == 6 ? source.firstRanks.r6_pOpen : rank == 7 ? source.firstRanks.r7_pOpen : rank == 8 ? source.lastRanks.r8_pOpen : rank == 9 ? source.lastRanks.r9_pOpen : rank == 10 ? source.lastRanks.r10_pOpen : rank == 11 ? source.lastRanks.r11_pOpen : rank == 12 ? source.lastRanks.r12_pOpen : source.lastRanks.r13_pOpen
        cached.pClose := rank == 1 ? source.firstRanks.r1_pClose : rank == 2 ? source.firstRanks.r2_pClose : rank == 3 ? source.firstRanks.r3_pClose : rank == 4 ? source.firstRanks.r4_pClose : rank == 5 ? source.firstRanks.r5_pClose : rank == 6 ? source.firstRanks.r6_pClose : rank == 7 ? source.firstRanks.r7_pClose : rank == 8 ? source.lastRanks.r8_pClose : rank == 9 ? source.lastRanks.r9_pClose : rank == 10 ? source.lastRanks.r10_pClose : rank == 11 ? source.lastRanks.r11_pClose : rank == 12 ? source.lastRanks.r12_pClose : source.lastRanks.r13_pClose
        cached.pHigh := rank == 1 ? source.firstRanks.r1_pHigh : rank == 2 ? source.firstRanks.r2_pHigh : rank == 3 ? source.firstRanks.r3_pHigh : rank == 4 ? source.firstRanks.r4_pHigh : rank == 5 ? source.firstRanks.r5_pHigh : rank == 6 ? source.firstRanks.r6_pHigh : rank == 7 ? source.firstRanks.r7_pHigh : rank == 8 ? source.lastRanks.r8_pHigh : rank == 9 ? source.lastRanks.r9_pHigh : rank == 10 ? source.lastRanks.r10_pHigh : rank == 11 ? source.lastRanks.r11_pHigh : rank == 12 ? source.lastRanks.r12_pHigh : source.lastRanks.r13_pHigh
        cached.pLow := rank == 1 ? source.firstRanks.r1_pLow : rank == 2 ? source.firstRanks.r2_pLow : rank == 3 ? source.firstRanks.r3_pLow : rank == 4 ? source.firstRanks.r4_pLow : rank == 5 ? source.firstRanks.r5_pLow : rank == 6 ? source.firstRanks.r6_pLow : rank == 7 ? source.firstRanks.r7_pLow : rank == 8 ? source.lastRanks.r8_pLow : rank == 9 ? source.lastRanks.r9_pLow : rank == 10 ? source.lastRanks.r10_pLow : rank == 11 ? source.lastRanks.r11_pLow : rank == 12 ? source.lastRanks.r12_pLow : source.lastRanks.r13_pLow
        cached.pComplete := rank == 1 ? source.firstRanks.r1_pComplete : rank == 2 ? source.firstRanks.r2_pComplete : rank == 3 ? source.firstRanks.r3_pComplete : rank == 4 ? source.firstRanks.r4_pComplete : rank == 5 ? source.firstRanks.r5_pComplete : rank == 6 ? source.firstRanks.r6_pComplete : rank == 7 ? source.firstRanks.r7_pComplete : rank == 8 ? source.lastRanks.r8_pComplete : rank == 9 ? source.lastRanks.r9_pComplete : rank == 10 ? source.lastRanks.r10_pComplete : rank == 11 ? source.lastRanks.r11_pComplete : rank == 12 ? source.lastRanks.r12_pComplete : source.lastRanks.r13_pComplete
        cached.aOpen := rank == 1 ? source.firstRanks.r1_aOpen : rank == 2 ? source.firstRanks.r2_aOpen : rank == 3 ? source.firstRanks.r3_aOpen : rank == 4 ? source.firstRanks.r4_aOpen : rank == 5 ? source.firstRanks.r5_aOpen : rank == 6 ? source.firstRanks.r6_aOpen : rank == 7 ? source.firstRanks.r7_aOpen : rank == 8 ? source.lastRanks.r8_aOpen : rank == 9 ? source.lastRanks.r9_aOpen : rank == 10 ? source.lastRanks.r10_aOpen : rank == 11 ? source.lastRanks.r11_aOpen : rank == 12 ? source.lastRanks.r12_aOpen : source.lastRanks.r13_aOpen
        cached.aClose := rank == 1 ? source.firstRanks.r1_aClose : rank == 2 ? source.firstRanks.r2_aClose : rank == 3 ? source.firstRanks.r3_aClose : rank == 4 ? source.firstRanks.r4_aClose : rank == 5 ? source.firstRanks.r5_aClose : rank == 6 ? source.firstRanks.r6_aClose : rank == 7 ? source.firstRanks.r7_aClose : rank == 8 ? source.lastRanks.r8_aClose : rank == 9 ? source.lastRanks.r9_aClose : rank == 10 ? source.lastRanks.r10_aClose : rank == 11 ? source.lastRanks.r11_aClose : rank == 12 ? source.lastRanks.r12_aClose : source.lastRanks.r13_aClose
        cached.aHigh := rank == 1 ? source.firstRanks.r1_aHigh : rank == 2 ? source.firstRanks.r2_aHigh : rank == 3 ? source.firstRanks.r3_aHigh : rank == 4 ? source.firstRanks.r4_aHigh : rank == 5 ? source.firstRanks.r5_aHigh : rank == 6 ? source.firstRanks.r6_aHigh : rank == 7 ? source.firstRanks.r7_aHigh : rank == 8 ? source.lastRanks.r8_aHigh : rank == 9 ? source.lastRanks.r9_aHigh : rank == 10 ? source.lastRanks.r10_aHigh : rank == 11 ? source.lastRanks.r11_aHigh : rank == 12 ? source.lastRanks.r12_aHigh : source.lastRanks.r13_aHigh
        cached.aLow := rank == 1 ? source.firstRanks.r1_aLow : rank == 2 ? source.firstRanks.r2_aLow : rank == 3 ? source.firstRanks.r3_aLow : rank == 4 ? source.firstRanks.r4_aLow : rank == 5 ? source.firstRanks.r5_aLow : rank == 6 ? source.firstRanks.r6_aLow : rank == 7 ? source.firstRanks.r7_aLow : rank == 8 ? source.lastRanks.r8_aLow : rank == 9 ? source.lastRanks.r9_aLow : rank == 10 ? source.lastRanks.r10_aLow : rank == 11 ? source.lastRanks.r11_aLow : rank == 12 ? source.lastRanks.r12_aLow : source.lastRanks.r13_aLow
        cached.aComplete := rank == 1 ? source.firstRanks.r1_aComplete : rank == 2 ? source.firstRanks.r2_aComplete : rank == 3 ? source.firstRanks.r3_aComplete : rank == 4 ? source.firstRanks.r4_aComplete : rank == 5 ? source.firstRanks.r5_aComplete : rank == 6 ? source.firstRanks.r6_aComplete : rank == 7 ? source.firstRanks.r7_aComplete : rank == 8 ? source.lastRanks.r8_aComplete : rank == 9 ? source.lastRanks.r9_aComplete : rank == 10 ? source.lastRanks.r10_aComplete : rank == 11 ? source.lastRanks.r11_aComplete : rank == 12 ? source.lastRanks.r12_aComplete : source.lastRanks.r13_aComplete
    not na(source) ? cached : na

//==============================================================================
// GXV AssetCorrelationUtils bridge
type SmtCorrelationDescriptor
    string symbol
    string displayName
    bool inverse
    bool configured
    SmtSourcePacket source

//==============================================================================
f_has_symbol(string s) =>
    str.length(s) > 0

f_asset_token(string s) =>
    array<string> parts = str.split(s, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : s

f_same_symbol(string a, string b) =>
    str.upper(a) == str.upper(b) or str.upper(f_asset_token(a)) == str.upper(f_asset_token(b))

string csym = ""
string tsym3 = ""
string qsym4 = ""
bool corr_base_ok = false
bool corr_has_tertiary = false
bool corr_has_quaternary = false
bool corr_pair1_configured = false
bool corr_pair2_configured = false
bool corr_pair3_configured = false
bool corr_inv1 = false
bool corr_inv2 = false
bool corr_inv3 = false
bool corr_type_pair2 = smt_correlation_type != "Dyad"
bool corr_type_pair3 = smt_correlation_type == "Tetrad"
bool corr_manual_mode = smt_pair_selection == "Manual"
bool corr_manual_pair1_ok = f_has_symbol(smt_manual_pair1) and not f_same_symbol(smt_manual_pair1, syminfo.tickerid)
bool corr_manual_pair2_ok = corr_type_pair2 and f_has_symbol(smt_manual_pair2) and not f_same_symbol(smt_manual_pair2, syminfo.tickerid) and not f_same_symbol(smt_manual_pair2, smt_manual_pair1)
bool corr_manual_pair3_ok = corr_type_pair3 and f_has_symbol(smt_manual_pair3) and not f_same_symbol(smt_manual_pair3, syminfo.tickerid) and not f_same_symbol(smt_manual_pair3, smt_manual_pair1) and not f_same_symbol(smt_manual_pair3, smt_manual_pair2)
if corr_manual_mode
    corr_base_ok := corr_manual_pair1_ok
    corr_has_tertiary := corr_manual_pair2_ok
    corr_has_quaternary := corr_manual_pair3_ok
    csym := corr_manual_pair1_ok ? smt_manual_pair1 : ""
    tsym3 := corr_manual_pair2_ok ? smt_manual_pair2 : ""
    qsym4 := corr_manual_pair3_ok ? smt_manual_pair3 : ""
    corr_inv1 := corr_manual_pair1_ok ? smt_manual_pair1_inverted : false
    corr_inv2 := corr_manual_pair2_ok ? smt_manual_pair2_inverted : false
    corr_inv3 := corr_manual_pair3_ok ? smt_manual_pair3_inverted : false
else
    var GXV.AssetConfig corr_cfg = GXV.resolveAssetsByCorrelation(syminfo.ticker, syminfo.tickerid, syminfo.type, syminfo.session, false, smt_correlation_mode, smt_correlation_type)
    corr_base_ok := corr_cfg.detected and f_has_symbol(corr_cfg.secondary) and not f_same_symbol(corr_cfg.secondary, syminfo.tickerid)
    corr_has_tertiary := corr_type_pair2 and corr_base_ok and f_has_symbol(corr_cfg.tertiary) and not f_same_symbol(corr_cfg.tertiary, syminfo.tickerid) and not f_same_symbol(corr_cfg.secondary, corr_cfg.tertiary)
    corr_has_quaternary := corr_type_pair3 and corr_has_tertiary and f_has_symbol(corr_cfg.quaternary) and not f_same_symbol(corr_cfg.quaternary, syminfo.tickerid) and not f_same_symbol(corr_cfg.quaternary, corr_cfg.secondary) and not f_same_symbol(corr_cfg.quaternary, corr_cfg.tertiary)
    csym := corr_base_ok ? corr_cfg.secondary : ""
    tsym3 := corr_has_tertiary ? corr_cfg.tertiary : ""
    qsym4 := corr_has_quaternary ? corr_cfg.quaternary : ""
    corr_inv1 := corr_base_ok ? corr_cfg.invertSecondary : false
    corr_inv2 := corr_has_tertiary ? corr_cfg.invertTertiary : false
    corr_inv3 := corr_has_quaternary ? corr_cfg.invertQuaternary : false
corr_pair1_configured := corr_base_ok and f_has_symbol(csym)
corr_pair2_configured := corr_has_tertiary and f_has_symbol(tsym3)
corr_pair3_configured := corr_has_quaternary and f_has_symbol(qsym4)
// Main state is local; remote state is calculated BEFORE bar merging.
// No rank-dependent or placeholder requests. Exact library symbol/session retained.
SmtCycleSet smt_main_cycles = f_smt_source_cycles()
SmtSourcePacket smt_source1 = na
SmtSourcePacket smt_source2 = na
SmtSourcePacket smt_source3 = na
if corr_pair1_configured
    smt_source1 := request.security(csym, tf, f_smt_source_packet(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
if corr_pair2_configured
    smt_source2 := request.security(tsym3, tf, f_smt_source_packet(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
if corr_pair3_configured
    smt_source3 := request.security(qsym4, tf, f_smt_source_packet(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
var string smt_pair = corr_pair1_configured ? GXV.getAssetTicker(csym) : ""
var string smt_pair2 = corr_pair2_configured ? GXV.getAssetTicker(tsym3) : ""
var string smt_pair3 = corr_pair3_configured ? GXV.getAssetTicker(qsym4) : ""
// Resolver inputs and symbol identity are constant within one script run.
// Reuse descriptors; only the current request result changes on each bar.
var SmtCorrelationDescriptor smt_corr_pair1 = SmtCorrelationDescriptor.new(csym, smt_pair, corr_inv1, corr_pair1_configured, na)
var SmtCorrelationDescriptor smt_corr_pair2 = SmtCorrelationDescriptor.new(tsym3, smt_pair2, corr_inv2, corr_pair2_configured, na)
var SmtCorrelationDescriptor smt_corr_pair3 = SmtCorrelationDescriptor.new(qsym4, smt_pair3, corr_inv3, corr_pair3_configured, na)
smt_corr_pair1.source := smt_source1
smt_corr_pair2.source := smt_source2
smt_corr_pair3.source := smt_source3

//==============================================================================
// GXV SMT market-state engine
// DATA -> RANGE -> SWEEP -> DIVERGENCE -> EVENT -> INVALIDATION -> PROJECTION
//==============================================================================
const int SMT_STATE_CYCLES = 13
const int SMT_PAIR_COUNT = 3
const int SMT_DIR_BEAR = -1
const int SMT_DIR_BULL = 1
const int SMT_EVENT_LIVE = 1
const int SMT_EVENT_CONFIRMED = 2
const int SMT_EVENT_INVALIDATED = 3
const int SMT_LIVE_SLOTS = SMT_STATE_CYCLES * SMT_PAIR_COUNT * 2
const int SMT_DOMAIN_EVENT_CAP = 600
const int SMT_RENDER_EVENT_CAP = 480

type SmtRangeState
    float currentHigh
    float previousHigh
    float currentLow
    float previousLow
    int currentHighTime
    int previousHighTime
    int currentLowTime
    int previousLowTime
    int currentHighBar
    int previousHighBar
    int currentLowBar
    int previousLowBar
    int cycleKey
    int previousCycleKey
    bool hasCurrentRange
    bool hasPreviousRange

type SmtSweepState
    bool ready
    bool highSwept
    bool lowSwept
    float highPivotA
    float highPivotB
    float lowPivotA
    float lowPivotB
    int highTimeA
    int highTimeB
    int lowTimeA
    int lowTimeB
    int highBarA
    int highBarB
    int lowBarA
    int lowBarB

type SmtEvent
    int id
    int rank
    int pairSlot
    int dir
    int cycleKey
    int previousCycleKey
    float pivotAPrice
    float pivotBPrice
    int pivotATime
    int pivotBTime
    int pivotABar
    int pivotBBar
    int structType
    int state
    bool bodyBlocked
    line lineId
    label labelId
    bool projectA
    bool projectB
    bool bypassed

type SmtLiveSlot
    bool active
    int eventId
    int cycleKey

// Availability is independent of event validity; only LIVE projection can wait.
var array<bool> smt_pending_slots = array.new_bool(SMT_LIVE_SLOTS, false)
var array<int> smt_processed_closes = array.new_int(SMT_STATE_CYCLES * SMT_PAIR_COUNT, na)
var array<SmtEvent> smt_events = array.new<SmtEvent>()
var array<SmtLiveSlot> smt_live_slots = array.new<SmtLiveSlot>()

f_smt_live_slot(int rank, int pairSlot, int dir) =>
    (rank - 1) * SMT_PAIR_COUNT * 2 + (pairSlot - 1) * 2 + (dir == SMT_DIR_BULL ? 1 : 0)

f_smt_event_id(int rank, int pairSlot, int dir, int cycleKey) =>
    cycleKey * 100 + f_smt_live_slot(rank, pairSlot, dir)

f_smt_seed_engine() =>
    if array.size(smt_live_slots) == 0
        for i = 0 to SMT_LIVE_SLOTS - 1
            array.push(smt_live_slots, SmtLiveSlot.new(false, na, na))
    0

f_smt_rank_enabled(int rank) =>
    rank == 1 ? smt_15m_show : rank == 2 ? smt_30m_show : rank == 3 ? smt_1h_show : rank == 4 ? smt_90m_show : rank == 5 ? smt_4h_show : rank == 6 ? smt_6h_show : rank == 7 ? smt_7h_show : rank == 8 ? smt_12h_show : rank == 9 ? smt_1d_show : rank == 10 ? smt_1w_show : rank == 11 ? smt_1m_show : rank == 12 ? smt_3m_show : rank == 13 ? smt_12m_show : false

f_smt_pair_enabled(int pairSlot) =>
    pairSlot == 1 ? smt_corr_pair1.configured : pairSlot == 2 ? smt_corr_pair2.configured : pairSlot == 3 ? smt_corr_pair3.configured : false

f_smt_rank_shortname(int rank) =>
    rank == 1 ? "15m" : rank == 2 ? "30m" : rank == 3 ? "1H" : rank == 4 ? "90m" : rank == 5 ? "4H" : rank == 6 ? "6H" : rank == 7 ? "7H" : rank == 8 ? "12H" : rank == 9 ? "1D" : rank == 10 ? "1W" : rank == 11 ? "1M" : rank == 12 ? "3M" : rank == 13 ? "12M" : ""

f_smt_rank_color(int rank) =>
    rank == 1 ? smt_15m_clr : rank == 2 ? smt_30m_clr : rank == 3 ? smt_1h_clr : rank == 4 ? smt_90m_clr : rank == 5 ? smt_4h_clr : rank == 6 ? smt_6h_clr : rank == 7 ? smt_7h_clr : rank == 8 ? smt_12h_clr : rank == 9 ? smt_1d_clr : rank == 10 ? smt_1w_clr : rank == 11 ? smt_1m_clr : rank == 12 ? smt_3m_clr : rank == 13 ? smt_12m_clr : color.gray

f_smt_rank_gate_sec(int rank) =>
    rank == 1 ? SMT_GATE_15M : rank == 2 ? SMT_GATE_30M : rank == 3 ? SMT_GATE_1H : rank == 4 ? SMT_GATE_90M : rank == 5 ? SMT_GATE_4H : rank == 6 ? SMT_GATE_6H : rank == 7 ? SMT_GATE_7H : rank == 8 ? SMT_GATE_12H : rank == 9 ? SMT_GATE_1D : rank == 10 ? SMT_GATE_1W : rank == 11 ? SMT_GATE_1M : rank == 12 ? SMT_GATE_3M : SMT_GATE_12M

f_smt_pair_name_for_slot(int pairSlot) =>
    pairSlot == 1 ? smt_corr_pair1.displayName : pairSlot == 2 ? smt_corr_pair2.displayName : pairSlot == 3 ? smt_corr_pair3.displayName : ""

f_smt_label_text(string shortname, string pairName) =>
    smt_label_style == "Asset Only" ? "SMT " + pairName : smt_label_style == "TF Only" ? shortname + " SMT" : shortname + " SMT " + pairName

f_smt_default_label_text(int rank, int pairSlot) =>
    f_smt_label_text(f_smt_rank_shortname(rank), f_smt_pair_name_for_slot(pairSlot))

f_smt_bypass_label_text(int rank, int pairSlot) =>
    smt_label_style == "Asset Only" ? f_smt_pair_name_for_slot(pairSlot) : f_smt_rank_shortname(rank)

f_smt_labels_for_rank(int rank) =>
    bool dynamicExcluded = rank == 12 or rank == 13
    bool hideAtOrAboveGate = smt_dynamic_labels and not dynamicExcluded and tf_sec >= f_smt_rank_gate_sec(rank)
    smt_labels_show and not hideAtOrAboveGate

f_smt_event_mid_y(float y1, float y2) =>
    math.round_to_mintick((y1 + y2) * 0.5)

f_smt_event_label_time(int x1, int x2, int b1, int b2) =>
    int labelBar = int(math.floor((b1 + b2) * 0.5))
    int labelOffset = bar_index - labelBar
    bool canUseMidBarTime = not na(labelBar) and labelOffset >= 0 and labelOffset <= 5000
    canUseMidBarTime ? time[labelOffset] : int(math.round(x1 + (x2 - x1) * 0.5))

f_smt_structure_type(bool isBull, float y1, float y2) =>
    isBull ? (y2 > y1 ? 1 : y2 < y1 ? 2 : 0) : (y2 > y1 ? 3 : y2 < y1 ? 4 : 0)

f_smt_struct_required_for_cleanup(int rank) =>
    rank == 11 or rank == 12 or rank == 13

f_smt_cleanup_struct_ok(int dominatedRank, int dominatedStruct, int dominantStruct) =>
    not f_smt_struct_required_for_cleanup(dominatedRank) or (dominatedStruct != 0 and dominatedStruct == dominantStruct)

f_smt_body_filter_applies(int rank) =>
    rank != 13

f_smt_body_intersects(int bx1, int bx2, float y1, float y2) =>
    bool hit = false
    int span = bx2 - bx1
    if span > 3
        int fromX = math.max(bx1 + 2, bar_index - 4999)
        int toX = math.min(bx2 - 2, bar_index)
        if fromX <= toX
            for x = fromX to toX
                int barsAgo = bar_index - x
                float linePrice = y1 + (y2 - y1) * (x - bx1) / span
                float bodyLow = math.min(open[barsAgo], close[barsAgo])
                float bodyHigh = math.max(open[barsAgo], close[barsAgo])
                if bodyLow <= linePrice and linePrice <= bodyHigh
                    hit := true
                    break
    hit

// Equality is not a liquidity take; strict extrema retain first-touch identity.
f_smt_high_swept(float currentValue, float previousValue) =>
    not na(currentValue) and not na(previousValue) and currentValue > previousValue

f_smt_low_swept(float currentValue, float previousValue) =>
    not na(currentValue) and not na(previousValue) and currentValue < previousValue

// Adapt source-owned snapshots to the stable detector's unchanged range type.
f_smt_main_view(SmtCycle cycle, bool closedView) =>
    SmtCandle a = closedView ? cycle.older : cycle.previous
    SmtCandle b = closedView ? cycle.previous : cycle.current
    SmtRangeState.new(b.hi, a.hi, b.lo, a.lo, b.hiTime, a.hiTime, b.loTime, a.loTime, b.hiBar, a.hiBar, b.loBar, a.loBar, b.openTime, a.openTime, b.complete and not na(b.hi) and not na(b.lo), a.complete and not na(a.hi) and not na(a.lo))

f_smt_remote_view(SmtRemoteCycle cycle, bool closedView) =>
    float bh = closedView ? cycle.pHigh : cycle.cHigh
    float bl = closedView ? cycle.pLow : cycle.cLow
    float ah = closedView ? cycle.aHigh : cycle.pHigh
    float al = closedView ? cycle.aLow : cycle.pLow
    bool bReady = (closedView ? cycle.pComplete : cycle.cComplete) and not na(bh) and not na(bl)
    bool aReady = (closedView ? cycle.aComplete : cycle.pComplete) and not na(ah) and not na(al)
    // Companion coordinates are never reconstructed on the main chart.
    SmtRangeState.new(bh, ah, bl, al, na, na, na, na, na, na, na, na, closedView ? cycle.pOpen : cycle.cOpen, closedView ? cycle.aOpen : cycle.pOpen, bReady, aReady)

f_smt_intervals_match(SmtCycle mainCycle, SmtRemoteCycle pairCycle, bool closedView) =>
    SmtCandle a = closedView ? mainCycle.older : mainCycle.previous
    SmtCandle b = closedView ? mainCycle.previous : mainCycle.current
    bool matched = false
    if not na(pairCycle) and not na(a.openTime) and not na(b.openTime)
        int pairAOpen = closedView ? pairCycle.aOpen : pairCycle.pOpen
        int pairAClose = closedView ? pairCycle.aClose : pairCycle.pClose
        int pairBOpen = closedView ? pairCycle.pOpen : pairCycle.cOpen
        int pairBClose = closedView ? pairCycle.pClose : pairCycle.cClose
        matched := a.openTime == pairAOpen and a.closeTime == pairAClose and b.openTime == pairBOpen and b.closeTime == pairBClose
    matched

// Inverse pairs are normalized once into main-domain high/low liquidity actions.
f_smt_build_sweeps(SmtRangeState st, bool inverse) =>
    bool ready = st.hasCurrentRange and st.hasPreviousRange
    float highA = inverse ? st.previousLow : st.previousHigh
    float highB = inverse ? st.currentLow : st.currentHigh
    float lowA = inverse ? st.previousHigh : st.previousLow
    float lowB = inverse ? st.currentHigh : st.currentLow
    int highTimeA = inverse ? st.previousLowTime : st.previousHighTime
    int highTimeB = inverse ? st.currentLowTime : st.currentHighTime
    int lowTimeA = inverse ? st.previousHighTime : st.previousLowTime
    int lowTimeB = inverse ? st.currentHighTime : st.currentLowTime
    int highBarA = inverse ? st.previousLowBar : st.previousHighBar
    int highBarB = inverse ? st.currentLowBar : st.currentHighBar
    int lowBarA = inverse ? st.previousHighBar : st.previousLowBar
    int lowBarB = inverse ? st.currentHighBar : st.currentLowBar
    bool highSweep = ready and (inverse ? f_smt_low_swept(highB, highA) : f_smt_high_swept(highB, highA))
    bool lowSweep = ready and (inverse ? f_smt_high_swept(lowB, lowA) : f_smt_low_swept(lowB, lowA))
    SmtSweepState.new(ready, highSweep, lowSweep, highA, highB, lowA, lowB, highTimeA, highTimeB, lowTimeA, lowTimeB, highBarA, highBarB, lowBarA, lowBarB)

f_smt_xor(bool first, bool second) =>
    (first and not second) or (not first and second)

// Pure divergence truth: exactly one synchronized market sweeps corresponding liquidity.
f_smt_resolve_pair_state(SmtSweepState mainSweep, SmtSweepState pairSweep) =>
    bool ready = mainSweep.ready and pairSweep.ready
    bool bearValid = ready and f_smt_xor(mainSweep.highSwept, pairSweep.highSwept)
    bool bullValid = ready and f_smt_xor(mainSweep.lowSwept, pairSweep.lowSwept)
    [bearValid, bullValid]
//==============================================================================
// Session and time projection policy
//==============================================================================
f_smt_time_to_minutes(string t) =>
    array<string> parts = str.split(t, ":")
    int h = array.size(parts) > 0 ? int(str.tonumber(array.get(parts, 0))) : 0
    int m = array.size(parts) > 1 ? int(str.tonumber(array.get(parts, 1))) : 0
    h * 60 + m

f_smt_minutes_in_window(int tMin, int startMin, int endMin) =>
    startMin <= endMin ? (tMin >= startMin and tMin <= endMin) : (tMin >= startMin or tMin <= endMin)

var int smt_session_1_start_min = f_smt_time_to_minutes(smt_session_1_start)
var int smt_session_1_end_min = f_smt_time_to_minutes(smt_session_1_end)
var int smt_session_2_start_min = f_smt_time_to_minutes(smt_session_2_start)
var int smt_session_2_end_min = f_smt_time_to_minutes(smt_session_2_end)
var int smt_session_3_start_min = f_smt_time_to_minutes(smt_session_3_start)
var int smt_session_3_end_min = f_smt_time_to_minutes(smt_session_3_end)
var int smt_session_4_start_min = f_smt_time_to_minutes(smt_session_4_start)
var int smt_session_4_end_min = f_smt_time_to_minutes(smt_session_4_end)

smt_session_filter_effective = smt_session_filter_on and not na(tf_sec) and tf_sec <= TF_SEC_30
smt_current_day_filter_effective = smt_render_current_day_only and not na(tf_sec) and tf_sec < TF_SEC_240
smt_render_day_ref = last_bar_time
smt_render_day_start = timestamp(oracle_tz, year(smt_render_day_ref, oracle_tz), month(smt_render_day_ref, oracle_tz), dayofmonth(smt_render_day_ref, oracle_tz), 0, 0)
smt_render_day_end = timestamp(oracle_tz, year(smt_render_day_ref, oracle_tz), month(smt_render_day_ref, oracle_tz), dayofmonth(smt_render_day_ref, oracle_tz) + 1, 0, 0)

smt_auto_reference_time = last_bar_time
smt_auto_current_minutes = smt_session_filter_effective and smt_auto_session_filter ? hour(smt_auto_reference_time, "America/New_York") * 60 + minute(smt_auto_reference_time, "America/New_York") : na
smt_auto_session_1_active = smt_session_filter_effective and smt_auto_session_filter and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_1_start_min, smt_session_1_end_min)
smt_auto_session_2_active = smt_session_filter_effective and smt_auto_session_filter and not smt_auto_session_1_active and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_2_start_min, smt_session_2_end_min)
smt_auto_session_3_active = smt_session_filter_effective and smt_auto_session_filter and not smt_auto_session_1_active and not smt_auto_session_2_active and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_3_start_min, smt_session_3_end_min)
smt_auto_session_4_active = smt_session_filter_effective and smt_auto_session_filter and not smt_auto_session_1_active and not smt_auto_session_2_active and not smt_auto_session_3_active and f_smt_minutes_in_window(smt_auto_current_minutes, smt_session_4_start_min, smt_session_4_end_min)

f_smt_session_render_ok(int pivotBTime) =>
    bool ok = true
    if smt_session_filter_effective
        ok := false
        if not na(pivotBTime)
            int pivotMinutes = hour(pivotBTime, "America/New_York") * 60 + minute(pivotBTime, "America/New_York")
            if smt_auto_session_filter
                ok := smt_auto_session_1_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_1_start_min, smt_session_1_end_min) : smt_auto_session_2_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_2_start_min, smt_session_2_end_min) : smt_auto_session_3_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_3_start_min, smt_session_3_end_min) : smt_auto_session_4_active ? f_smt_minutes_in_window(pivotMinutes, smt_session_4_start_min, smt_session_4_end_min) : false
            else
                bool inSession1 = smt_session_1_on and f_smt_minutes_in_window(pivotMinutes, smt_session_1_start_min, smt_session_1_end_min)
                bool inSession2 = smt_session_2_on and f_smt_minutes_in_window(pivotMinutes, smt_session_2_start_min, smt_session_2_end_min)
                bool inSession3 = smt_session_3_on and f_smt_minutes_in_window(pivotMinutes, smt_session_3_start_min, smt_session_3_end_min)
                bool inSession4 = smt_session_4_on and f_smt_minutes_in_window(pivotMinutes, smt_session_4_start_min, smt_session_4_end_min)
                ok := inSession1 or inSession2 or inSession3 or inSession4
    ok

f_smt_current_day_render_ok(int pivotBTime) =>
    not smt_current_day_filter_effective or (not na(pivotBTime) and pivotBTime >= smt_render_day_start and pivotBTime < smt_render_day_end)

f_smt_render_time_ok(int pivotBTime) =>
    f_smt_session_render_ok(pivotBTime) and f_smt_current_day_render_ok(pivotBTime)

f_smt_nearby_render_ok(int pivotBBar) =>
    not smt_render_nearby_only or (not na(pivotBBar) and pivotBBar >= last_bar_index - smt_nearby_bars)

//==============================================================================
// Domain event lifecycle
//==============================================================================
f_smt_find_event_by_id(int eventId) =>
    int idx = -1
    int i = 0
    while i < array.size(smt_events) and idx < 0
        if array.get(smt_events, i).id == eventId
            idx := i
        i += 1
    idx

f_smt_drop_render_at(int idx) =>
    if idx >= 0 and idx < array.size(smt_events)
        SmtEvent event = array.get(smt_events, idx)
        if not na(event.labelId)
            label.delete(event.labelId)
            event.labelId := na
        if not na(event.lineId)
            line.delete(event.lineId)
            event.lineId := na
        array.set(smt_events, idx, event)
    0

f_smt_delete_event_at(int idx) =>
    bool deleted = false
    if idx >= 0 and idx < array.size(smt_events)
        f_smt_drop_render_at(idx)
        array.remove(smt_events, idx)
        deleted := true
    deleted

f_smt_release_live_slot(int slot) =>
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        live.active := false
        live.eventId := na
        live.cycleKey := na
        array.set(smt_live_slots, slot, live)
    0

f_smt_remove_live_slot(int slot) =>
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        if live.active and not na(live.eventId)
            int eventIdx = f_smt_find_event_by_id(live.eventId)
            if eventIdx >= 0
                f_smt_delete_event_at(eventIdx)
        f_smt_release_live_slot(slot)
    0

f_smt_finalize_live_slot(int slot, int currentCycle) =>
    bool finalized = false
    if slot >= 0 and slot < array.size(smt_live_slots)
        SmtLiveSlot live = array.get(smt_live_slots, slot)
        if live.active and not na(currentCycle) and not na(live.cycleKey) and currentCycle != live.cycleKey
            int eventIdx = f_smt_find_event_by_id(live.eventId)
            if eventIdx >= 0
                SmtEvent event = array.get(smt_events, eventIdx)
                if event.state == SMT_EVENT_LIVE
                    event.state := SMT_EVENT_CONFIRMED
                    event.projectA := false
                    event.projectB := false
                    event.bypassed := false
                    array.set(smt_events, eventIdx, event)
                    finalized := true
            f_smt_release_live_slot(slot)
    finalized

f_smt_sync_live_candidate(bool valid, int cycleKey, int previousCycleKey, int rank, int pairSlot, int dir, float y1, float y2, int t1, int t2, int b1, int b2) =>
    int slot = f_smt_live_slot(rank, pairSlot, dir)
    SmtLiveSlot live = array.get(smt_live_slots, slot)
    bool fieldsReady = not na(cycleKey) and not na(previousCycleKey) and not na(y1) and not na(y2) and not na(t1) and not na(t2) and not na(b1) and not na(b2)
    if live.active and (not valid or not fieldsReady or live.cycleKey != cycleKey)
        f_smt_remove_live_slot(slot)
        live := array.get(smt_live_slots, slot)
    if valid and fieldsReady
        int eventId = f_smt_event_id(rank, pairSlot, dir, cycleKey)
        int eventIdx = live.active ? f_smt_find_event_by_id(live.eventId) : -1
        if eventIdx < 0
            bool bodyBlocked = f_smt_body_filter_applies(rank) and f_smt_body_intersects(b1, b2, y1, y2)
            SmtEvent event = SmtEvent.new(eventId, rank, pairSlot, dir, cycleKey, previousCycleKey, y1, y2, t1, t2, b1, b2, f_smt_structure_type(dir == SMT_DIR_BULL, y1, y2), SMT_EVENT_LIVE, bodyBlocked, na, na, false, false, false)
            array.unshift(smt_events, event)
            live.active := true
            live.eventId := eventId
            live.cycleKey := cycleKey
            array.set(smt_live_slots, slot, live)
        else
            SmtEvent event = array.get(smt_events, eventIdx)
            bool pivotChanged = event.pivotAPrice != y1 or event.pivotBPrice != y2 or event.pivotATime != t1 or event.pivotBTime != t2 or event.pivotABar != b1 or event.pivotBBar != b2
            if pivotChanged
                event.pivotAPrice := y1
                event.pivotBPrice := y2
                event.pivotATime := t1
                event.pivotBTime := t2
                event.pivotABar := b1
                event.pivotBBar := b2
                event.structType := f_smt_structure_type(dir == SMT_DIR_BULL, y1, y2)
                event.bodyBlocked := f_smt_body_filter_applies(rank) and f_smt_body_intersects(b1, b2, y1, y2)
                array.set(smt_events, eventIdx, event)
    0

f_smt_event_invalidated(SmtEvent event) =>
    event.state == SMT_EVENT_CONFIRMED and bar_index > event.pivotBBar and ((event.dir == SMT_DIR_BEAR and high >= event.pivotBPrice) or (event.dir == SMT_DIR_BULL and low <= event.pivotBPrice))

f_smt_mark_historical_invalidations() =>
    int n = array.size(smt_events)
    if n > 0
        for i = n - 1 to 0
            SmtEvent event = array.get(smt_events, i)
            if f_smt_event_invalidated(event)
                event.state := SMT_EVENT_INVALIDATED
                event.projectA := false
                event.projectB := false
                array.set(smt_events, i, event)
    0

f_smt_gc_events() =>
    int i = array.size(smt_events) - 1
    while i >= 0
        if array.get(smt_events, i).state == SMT_EVENT_INVALIDATED
            f_smt_delete_event_at(i)
        i -= 1
    while array.size(smt_events) > SMT_DOMAIN_EVENT_CAP
        int removeIdx = array.size(smt_events) - 1
        while removeIdx >= 0 and array.get(smt_events, removeIdx).state == SMT_EVENT_LIVE
            removeIdx -= 1
        if removeIdx >= 0
            f_smt_delete_event_at(removeIdx)
        else
            break
    0
//==============================================================================
// Deterministic render projection and arbitration
//==============================================================================
f_smt_event_base_render_ok(SmtEvent event) =>
    bool activeState = event.state == SMT_EVENT_LIVE or event.state == SMT_EVENT_CONFIRMED
    bool dataAvailable = event.state != SMT_EVENT_LIVE or not array.get(smt_pending_slots, f_smt_live_slot(event.rank, event.pairSlot, event.dir))
    activeState and dataAvailable and f_smt_rank_enabled(event.rank) and f_smt_pair_enabled(event.pairSlot) and f_smt_monthly_tf_render_ok(event.rank) and f_smt_nearby_render_ok(event.pivotBBar) and f_smt_render_time_ok(event.pivotBTime) and not event.bodyBlocked

f_smt_hard_winner(SmtEvent dominant, SmtEvent candidate) =>
    dominant.rank > candidate.rank or (dominant.rank == candidate.rank and dominant.pairSlot < candidate.pairSlot) or (dominant.rank == candidate.rank and dominant.pairSlot == candidate.pairSlot and dominant.id < candidate.id)

f_smt_hard_loses(int idx) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectA and candidate.dir != 0 and not na(candidate.pivotATime) and not na(candidate.pivotBTime) and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent other = array.get(smt_events, i)
                bool sameEvent = other.projectA and other.dir == candidate.dir and other.pivotATime == candidate.pivotATime and other.pivotBTime == candidate.pivotBTime
                loses := sameEvent and f_smt_hard_winner(other, candidate)
    loses

f_smt_inside_dominates(SmtEvent keeper, SmtEvent candidate) =>
    int keepLeft = math.min(keeper.pivotABar, keeper.pivotBBar)
    int keepRight = math.max(keeper.pivotABar, keeper.pivotBBar)
    int candidateLeft = math.min(candidate.pivotABar, candidate.pivotBBar)
    int candidateRight = math.max(candidate.pivotABar, candidate.pivotBBar)
    int keepSpan = keepRight - keepLeft
    int candidateSpan = candidateRight - candidateLeft
    bool directionOk = keeper.dir != 0 and keeper.dir == candidate.dir
    bool structureOk = f_smt_cleanup_struct_ok(candidate.rank, candidate.structType, keeper.structType)
    bool priorityOk = keeper.rank > candidate.rank or (keeper.rank == candidate.rank and keepSpan > candidateSpan)
    candidateLeft >= keepLeft + 1 and candidateRight <= keepRight - 1 and keepSpan > candidateSpan and candidateSpan > 0 and keepSpan >= 3 and directionOk and structureOk and priorityOk

f_smt_inside_loses(int idx) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectB and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent keeper = array.get(smt_events, i)
                loses := keeper.projectB and f_smt_inside_dominates(keeper, candidate)
    loses

f_smt_pivot_winner(SmtEvent dominant, SmtEvent candidate) =>
    dominant.rank > candidate.rank or (dominant.rank == candidate.rank and dominant.id < candidate.id)

f_smt_pivot_loses(int idx, bool checkPivotA) =>
    bool loses = false
    SmtEvent candidate = array.get(smt_events, idx)
    int n = array.size(smt_events)
    if candidate.projectA and candidate.dir != 0 and n > 1
        for i = 0 to n - 1
            if i != idx and not loses
                SmtEvent other = array.get(smt_events, i)
                bool samePivot = checkPivotA ? other.pivotATime == candidate.pivotATime : other.pivotBTime == candidate.pivotBTime
                bool directionOk = other.dir == candidate.dir
                bool structureOk = f_smt_cleanup_struct_ok(candidate.rank, candidate.structType, other.structType)
                loses := other.projectA and samePivot and directionOk and structureOk and f_smt_pivot_winner(other, candidate)
    loses

f_smt_prepare_projection() =>
    int n = array.size(smt_events)
    if n > 0
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool baseEligible = f_smt_event_base_render_ok(event)
            event.projectA := baseEligible
            event.projectB := baseEligible
            event.bypassed := false
            array.set(smt_events, i, event)

        // Exact A-B arbitration is independent from optional cleanup modes.
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            event.projectB := event.projectA and not f_smt_hard_loses(i)
            array.set(smt_events, i, event)

        bool insideBypassMode = smt_cleanup_mode == "Bypass Inside Range"
        bool evaluateInside = smt_cleanup_inside or insideBypassMode
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool losesInside = evaluateInside and event.projectB and f_smt_inside_loses(i)
            event.projectA := event.projectB and not (smt_cleanup_inside and losesInside)
            event.bypassed := smt_aesthetic_bypass and insideBypassMode and losesInside
            array.set(smt_events, i, event)

        bool pivotABypassMode = smt_cleanup_mode == "Bypass Pivot A"
        bool pivotBBypassMode = smt_cleanup_mode == "Bypass Pivot B"
        bool evaluatePivotA = smt_cleanup_pivot_a or pivotABypassMode
        bool evaluatePivotB = smt_cleanup_pivot_b or pivotBBypassMode
        for i = 0 to n - 1
            SmtEvent event = array.get(smt_events, i)
            bool losesPivotA = evaluatePivotA and event.projectA and f_smt_pivot_loses(i, true)
            bool losesPivotB = evaluatePivotB and event.projectA and f_smt_pivot_loses(i, false)
            bool removed = (smt_cleanup_pivot_a and losesPivotA) or (smt_cleanup_pivot_b and losesPivotB)
            event.projectB := event.projectA and not removed
            bool pivotBypassed = (pivotABypassMode and losesPivotA) or (pivotBBypassMode and losesPivotB)
            event.bypassed := event.bypassed or (smt_aesthetic_bypass and pivotBypassed)
            array.set(smt_events, i, event)
    0

f_smt_sync_render_at(int idx, bool shouldRender) =>
    if idx >= 0 and idx < array.size(smt_events)
        SmtEvent event = array.get(smt_events, idx)
        if shouldRender
            color eventColor = event.bypassed ? color.new(f_smt_rank_color(event.rank), 65) : f_smt_rank_color(event.rank)
            if na(event.lineId)
                event.lineId := line.new(x1=event.pivotATime, y1=event.pivotAPrice, x2=event.pivotBTime, y2=event.pivotBPrice, xloc=xloc.bar_time, color=eventColor, width=1, style=smt_line_style)
            else
                line.set_xy1(event.lineId, event.pivotATime, event.pivotAPrice)
                line.set_xy2(event.lineId, event.pivotBTime, event.pivotBPrice)
                line.set_color(event.lineId, eventColor)
                line.set_style(event.lineId, smt_line_style)
            bool labelsOn = f_smt_labels_for_rank(event.rank)
            if labelsOn
                int labelTime = f_smt_event_label_time(event.pivotATime, event.pivotBTime, event.pivotABar, event.pivotBBar)
                string defaultText = f_smt_default_label_text(event.rank, event.pairSlot)
                string displayText = event.bypassed ? (smt_bypass_labels_show ? f_smt_bypass_label_text(event.rank, event.pairSlot) : "") : defaultText
                color textColor = event.bypassed ? (smt_bypass_labels_show ? color.new(smt_txt_all, 50) : color.new(smt_txt_all, 100)) : smt_txt_all
                if na(event.labelId)
                    event.labelId := label.new(x=labelTime, y=f_smt_event_mid_y(event.pivotAPrice, event.pivotBPrice), text=displayText, xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.white, 100), style=event.dir == SMT_DIR_BULL ? label.style_label_up : label.style_label_down, textcolor=textColor, size=smt_label_size, tooltip=defaultText)
                else
                    label.set_x(event.labelId, labelTime)
                    label.set_y(event.labelId, f_smt_event_mid_y(event.pivotAPrice, event.pivotBPrice))
                    label.set_text(event.labelId, displayText)
                    label.set_textcolor(event.labelId, textColor)
                    label.set_size(event.labelId, smt_label_size)
            else if not na(event.labelId)
                label.delete(event.labelId)
                event.labelId := na
        else
            if not na(event.labelId)
                label.delete(event.labelId)
                event.labelId := na
            if not na(event.lineId)
                line.delete(event.lineId)
                event.lineId := na
        array.set(smt_events, idx, event)
    0

f_smt_project_events() =>
    if barstate.islast
        f_smt_prepare_projection()
        array<int> bucketCounts = array.new_int(SMT_LIVE_SLOTS, 0)
        int rendered = 0
        int n = array.size(smt_events)
        if n > 0
            // Global object pressure is resolved by rank first, then recency.
            for rankCursor = SMT_STATE_CYCLES to 1
                for i = 0 to n - 1
                    SmtEvent event = array.get(smt_events, i)
                    if event.rank == rankCursor
                        bool shouldRender = event.projectB
                        if shouldRender and event.state == SMT_EVENT_CONFIRMED
                            int bucket = f_smt_live_slot(event.rank, event.pairSlot, event.dir)
                            int bucketCount = array.get(bucketCounts, bucket)
                            shouldRender := bucketCount < smt_history_limit
                            if shouldRender
                                array.set(bucketCounts, bucket, bucketCount + 1)
                        shouldRender := shouldRender and rendered < SMT_RENDER_EVENT_CAP
                        if shouldRender
                            rendered += 1
                        event.projectA := shouldRender
                        array.set(smt_events, i, event)
            for i = 0 to n - 1
                f_smt_sync_render_at(i, array.get(smt_events, i).projectA)
    0
//==============================================================================
// Family runtime
//==============================================================================
// The adapter handles delivery timing. Stable sweep truth, candidate identity,
// finalization, invalidation and arbitration helpers remain unchanged.
f_smt_resolve_view(SmtRangeState mainState, SmtRangeState pairState, bool inverse, int rank, int pairSlot, bool closedView, float afterHigh, float afterLow) =>
    SmtSweepState mainSweep = f_smt_build_sweeps(mainState, false)
    SmtSweepState pairSweep = f_smt_build_sweeps(pairState, inverse)
    [bearValid, bullValid] = f_smt_resolve_pair_state(mainSweep, pairSweep)
    // Late delivery must not resurrect B after an endpoint breach in C.
    // These are the stable engine's inclusive invalidation thresholds.
    if closedView
        bearValid := bearValid and (na(afterHigh) or afterHigh < mainSweep.highPivotB)
        bullValid := bullValid and (na(afterLow) or afterLow > mainSweep.lowPivotB)
    f_smt_sync_live_candidate(bearValid, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BEAR, mainSweep.highPivotA, mainSweep.highPivotB, mainSweep.highTimeA, mainSweep.highTimeB, mainSweep.highBarA, mainSweep.highBarB)
    f_smt_sync_live_candidate(bullValid, mainState.cycleKey, mainState.previousCycleKey, rank, pairSlot, SMT_DIR_BULL, mainSweep.lowPivotA, mainSweep.lowPivotB, mainSweep.lowTimeA, mainSweep.lowTimeB, mainSweep.lowBarA, mainSweep.lowBarB)
    0

f_smt_run_pair(SmtCycle mainCycle, bool engineEnabled, SmtCorrelationDescriptor pair, int rank, int pairSlot) =>
    int bearSlot = f_smt_live_slot(rank, pairSlot, SMT_DIR_BEAR)
    int bullSlot = f_smt_live_slot(rank, pairSlot, SMT_DIR_BULL)
    int deliveryIdx = (rank - 1) * SMT_PAIR_COUNT + pairSlot - 1
    SmtCandle current = mainCycle.current
    SmtCandle previous = mainCycle.previous
    SmtSourcePacket source = pair.source
    SmtRemoteCycle remote = f_smt_remote_cycle(source, rank)
    bool available = engineEnabled and pair.configured and not na(remote) and not na(current.openTime)
    array.set(smt_pending_slots, bearSlot, true)
    array.set(smt_pending_slots, bullSlot, true)
    if available
        // Closed comparisons require matching A/B windows, not matching live
        // base bars. Source rollover supplies immutable completed-window prices.
        bool closedAligned = f_smt_intervals_match(mainCycle, remote, true) and current.openTime >= previous.closeTime and remote.cOpen >= remote.pClose and source.sampleTime <= time_close
        int processed = array.get(smt_processed_closes, deliveryIdx)
        if closedAligned and (na(processed) or previous.openTime > processed)
            SmtRangeState mainClosed = f_smt_main_view(mainCycle, true)
            SmtRangeState pairClosed = f_smt_remote_view(remote, true)
            f_smt_resolve_view(mainClosed, pairClosed, pair.inverse, rank, pairSlot, true, current.hi, current.lo)
            f_smt_finalize_live_slot(bearSlot, current.openTime)
            f_smt_finalize_live_slot(bullSlot, current.openTime)
            array.set(smt_processed_closes, deliveryIdx, previous.openTime)
        // A stale/future source sample cannot pose as a synchronized preview.
        bool sameHorizon = source.sampleTime == time and source.sampleClose == time_close
        bool liveAligned = sameHorizon and f_smt_intervals_match(mainCycle, remote, false)
        if liveAligned
            SmtRangeState mainLive = f_smt_main_view(mainCycle, false)
            SmtRangeState pairLive = f_smt_remote_view(remote, false)
            f_smt_resolve_view(mainLive, pairLive, pair.inverse, rank, pairSlot, false, na, na)
            array.set(smt_pending_slots, bearSlot, false)
            array.set(smt_pending_slots, bullSlot, false)
    // Missing data hides provisional events; it cannot erase confirmed history.
    0

f_run_smt_cycle(bool engineEnabled, int rank) =>
    SmtCycle mainCycle = f_smt_local_cycle(smt_main_cycles, rank)
    f_smt_run_pair(mainCycle, engineEnabled, smt_corr_pair1, rank, 1)
    f_smt_run_pair(mainCycle, engineEnabled, smt_corr_pair2, rank, 2)
    f_smt_run_pair(mainCycle, engineEnabled, smt_corr_pair3, rank, 3)
    0

//==============================================================================
// GXV SMT execution
//==============================================================================
if barstate.isfirst and not chart.is_standard
    runtime.error("GXV SMT cycle reconstruction requires standard time-based candles.")
f_smt_seed_engine()
f_run_smt_cycle(tf_ok_12m, 13)
f_run_smt_cycle(tf_ok_3m, 12)
f_run_smt_cycle(tf_ok_1m, 11)
f_run_smt_cycle(tf_ok_1w, 10)
f_run_smt_cycle(tf_ok_1d, 9)
f_run_smt_cycle(tf_ok_12h, 8)
f_run_smt_cycle(tf_ok_7h, 7)
f_run_smt_cycle(tf_ok_6h, 6)
f_run_smt_cycle(tf_ok_4h, 5)
f_run_smt_cycle(tf_ok_90m, 4)
f_run_smt_cycle(tf_ok_1h, 3)
f_run_smt_cycle(tf_ok_30m, 2)
f_run_smt_cycle(tf_ok_15m, 1)

// Check newly confirmed events on the rollover bar itself.
f_smt_mark_historical_invalidations()
f_smt_gc_events()
f_smt_project_events()
